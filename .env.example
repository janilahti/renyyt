# Renyyt environment configuration example.
# Copy this file to .env and uncomment only the settings you want to change.
# Existing process environment variables always take precedence over .env.
# Values containing spaces are best quoted, for example:
# Build metadata defaults to the packaged manifest (Git commit/time in unbuilt clones).
# RENYYT_BUILD_TIME="2026-10-04 14:30:00 +0300"

# Runtime paths and network
# Runtime web/document resource root, not a writable-state-only directory.
# RENYYT_DATA_ROOT=
# RENYYT_HOST=127.0.0.1
# RENYYT_PORT=18514
# PORT=18514
# RENYYT_PORT takes precedence over PORT (including the container health check).
# RENYYT_BASE_PATH=
# Enable PWA install UI, manifest and service worker/offline app-shell cache.
# RENYYT_PWA_ENABLED=true

# Upstream request timeouts (seconds)
# RENYYT_SESSION_TIMEOUT=10
# RENYYT_LOGIN_TIMEOUT=15
# RENYYT_SERVICES_TIMEOUT=20

# Logging
# RENYYT_LOG_LEVEL=INFO
# Log levels:
#   INFO  - normal operational messages, warnings and errors.
#   DEBUG - detailed diagnostics without credentials, customer numbers, passwords or response bodies.
#   TRACE - intentionally sensitive diagnostics. API TRACE output is limited to JSON request/response data; SMTP TRACE may include credentials, message content and protocol responses. Use only temporarily for troubleshooting and protect the resulting logs accordingly.
# RENYYT_LOG_FORMAT=text

# Version/build metadata
# Defaults to the VERSION file; override only when needed.
# RENYYT_VERSION=0.9.0
# Build metadata defaults to the packaged manifest (Git commit/time in unbuilt clones).
# RENYYT_BUILD_TIME=
# RENYYT_GIT_COMMIT=

# Reverse proxy / host validation (comma-separated values)
# RENYYT_ALLOWED_ORIGINS=
# RENYYT_ALLOWED_HOSTS=
# RENYYT_TRUSTED_PROXIES=

# HTTP limits and authentication rate limiting
# RENYYT_MAX_REQUEST_BODY=16384
# RENYYT_CLIENT_SOCKET_TIMEOUT=30
# RENYYT_RATE_LIMIT_ATTEMPTS=8
# RENYYT_RATE_LIMIT_WINDOW=300
# RENYYT_RATE_LIMIT_BLOCK=600
# RENYYT_RATE_LIMIT_CLEANUP_INTERVAL=300
# RENYYT_RATE_LIMIT_WHITELIST=

# Optional in-memory API response cache. Disabled unless both MAX_ENTRIES and TTL_SECONDS are > 0.
# RENYYT_CACHE_MAX_ENTRIES=0
# RENYYT_CACHE_TTL_SECONDS=0
# RENYYT_CACHE_MAX_BYTES=16777216

# Development/test fixture: serve this JSON instead of calling the upstream service.
# Leave unset in normal use. Relative paths are resolved from the Renyyt data root.
# RENYYT_FIXTURE_FILE=/path/to/renyyt-response.json


# Optional Web Push collection reminders. Disabled by default.
# Python/venv installs: pip install 'renyyt[push]'
# Native deb/rpm: optional python3-pywebpush suggestion; see deploy/linux/README.md.
# Never pip install into distribution Python; use an isolated venv if unavailable.
# The server stores push subscriptions and reminder dates/labels, never Renyy login credentials.
# RENYYT_REMINDERS_ENABLED=false
# SQLite database path. If omitted, RENYYT_DATA_ROOT/reminders.sqlite3 is used when DATA_ROOT is set,
# otherwise ~/.local/share/renyyt/reminders.sqlite3.
# Set an explicit persistent writable path for containers/systemd. Keep DB/WAL/SHM files private.
# RENYYT_REMINDERS_DB=
# Run the reminder scanner inside the HTTP server process. If false, call `renyyt reminders run-due` externally.
# RENYYT_REMINDERS_INTERNAL_SCHEDULER=false
# Local wall-clock times for the internal scheduler (comma-separated HH:MM values).
# RENYYT_REMINDERS_RUN_TIMES=07:00,18:00
# `local` uses the server's local timezone; UTC is always supported. Named IANA zones require Python 3.9+.
# RENYYT_REMINDERS_TIMEZONE=local
# Generate keys after installing the push extra with: renyyt reminders generate-vapid
# RENYYT_VAPID_PRIVATE_KEY=
# RENYYT_VAPID_PUBLIC_KEY=
# RENYYT_VAPID_SUBJECT=mailto:admin@example.com
# Push-service message TTL in seconds.
# RENYYT_PUSH_TTL=86400

# Optional SMTP feedback. Gmail example: smtp.gmail.com:587 + STARTTLS + App Password.
# Feedback is enabled when HOST, FROM and TO are set.
# RENYYT_SMTP_HOST=smtp.gmail.com
# RENYYT_SMTP_PORT=587
# RENYYT_SMTP_USER=sender@example.com
# RENYYT_SMTP_PASSWORD=your-app-password
# FROM defaults to SMTP_USER when omitted.
# RENYYT_SMTP_FROM=sender@example.com
# RENYYT_SMTP_TO=feedback@example.com
# RENYYT_SMTP_STARTTLS=true
# RENYYT_SMTP_SSL=false
# RENYYT_SMTP_TIMEOUT=10
# RENYYT_FEEDBACK_RATE_LIMIT=5
# RENYYT_FEEDBACK_RATE_WINDOW=600
# Maximum JSON collection-data attachment size for feedback (bytes).
# RENYYT_FEEDBACK_MAX_DATA_BYTES=262144

# Build/package reproducibility. Unix timestamp; unset means current build time where applicable.
# SOURCE_DATE_EPOCH=

# Optional override for the dotenv file itself. This variable must be supplied by the
# process environment because it determines which file is loaded.
# RENYYT_ENV_FILE=/etc/renyyt/renyyt.env
