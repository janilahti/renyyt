[Unit]
Description=Renyyt due Web Push reminders
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=renyyt
Group=renyyt
WorkingDirectory=/opt/renyyt
Environment=RENYYT_REMINDERS_DB=/var/lib/renyyt/reminders.sqlite3
EnvironmentFile=/etc/renyyt/renyyt.env
ExecStart=/opt/renyyt/venv/bin/renyyt reminders run-due
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=renyyt
StateDirectoryMode=0700
