[Unit]
Description=Renyyt – seuraavat tyhjennykset
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=renyyt
Group=renyyt
WorkingDirectory=/opt/renyyt
Environment=RENYYT_REMINDERS_DB=/var/lib/renyyt/reminders.sqlite3
EnvironmentFile=-/etc/renyyt.env
ExecStart=/opt/renyyt/venv/bin/renyyt
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=renyyt
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
